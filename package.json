{
  "name": "nexus-crm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"node --watch server/dev.js\"",
    "build": "vite build",
    "start": "node server/dev.js",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test --test-concurrency=1 tests/*.test.js",
    "test:ui": "vitest run",
    "format": "prettier --write src server api tests *.js *.json docs README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "pdfkit": "^0.20.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vite": "^7.1.7",
    "vitest": "^5.0.4"
  }
}
